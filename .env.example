ENVIRONMENT=development
# Plaid (read-only). sandbox returns fake data; real Chase balances need production access.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
# Alerts via Telegram (free; the default channel). Create a bot with @BotFather, then run scripts/telegram_setup.py
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=            # comma-separated, one per person (you, your partner)
# Alerts via SMS (optional, paid after Twilio's 30-day trial)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
ALERT_PHONE_NUMBER=
# Low-balance rule (v1)
CUSHION_USD=1000
# Persistence (later): sqlite file at first, postgres when needed
# DATABASE_URL=sqlite:///.data/ufo.db
